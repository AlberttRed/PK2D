[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/database_editor/shop_editor_window.gd" id="1_script"]

[node name="ShopEditorWindow" type="Window"]
script = ExtResource("1_script")
initial_position = 2
size = Vector2i(720, 520)
title = "Shop Editor"

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 3
