[resource]
resource_name = "144 - Transformación"
script = ExtResource("1_8sgx6")
internal_name = "transform"
Name = "Transformación"
id = 144
description = "El usuario se transforma en una copia del objetivo, con
los mismos movimientos."
type_id = 1
type = ExtResource("2_ec60b")
pp = 10
damage_class_id = 1
effect_entries = "User becomes a copy of the target until it leaves battle. User copies the target's species, weight, type, ability, calculated stats (except HP), and moves.  Copied moves will all have 5 PP remaining.  IVs are copied for the purposes of hidden power, but stats are not recalculated.

choice band, choice scarf, and choice specs stay in effect, and the user must select a new move.

This move cannot be copied by mirror move, nor forced by encore."
target_id = 10
meta_category_id = 13
category = ExtResource("1_ntdrl")
