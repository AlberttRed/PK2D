[resource]
resource_name = "195 - Canto Mortal"
script = ExtResource("1_hkl0l")
internal_name = "perish-song"
Name = "Canto Mortal"
id = 195
description = "Si un Pokémon escucha este canto y no es cambiado
por otro en tres turnos, acaba debilitándose. "
type_id = 1
type = ExtResource("2_dwnfc")
pp = 5
damage_class_id = 1
effect_entries = "User and target both faint after three turns. Every Pokémon is given a counter that starts at 3 and decreases by 1 at the end of every turn, including this one.  When a Pokémon's counter reaches zero, that Pokémon faints.  A Pokémon that leaves the field will lose its counter; its replacement does not inherit the effect, and other Pokémon's counters remain.

This effect is passed on by baton pass.

This move cannot be copied by mirror move."
target_id = 14
meta_ailment_id = 20
meta_min_turns = 3
meta_max_turns = 3
meta_ailment_chance = 100
